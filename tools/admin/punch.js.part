(() => {
'use strict';
const root = document.documentElement;
root.setAttribute('dir', 'rtl');
root.setAttribute('lang', 'he');

const DEFAULTS = { studioName: 'הסטודיו של ספיר', cardSize: 6, ownerPhone: '', siteUrl: '' };
const AWAY_DAYS = 35, LOG_MAX = 40, DAY = 86400000;
const STOPS = ['#EFD4C6', '#EDBAB8', '#E39AA8', '#D5738F', '#C15075', '#A1365E', '#7E2448'];
const NAIL = 'M16 1.6C23 5.2 29.4 14.2 29.4 26.2C29.4 36.6 23.4 42.6 16 42.6C8.6 42.6 2.6 36.6 2.6 26.2C2.6 14.2 9 5.2 16 1.6Z';
const SHINE = 'M8.6 14.4C6.9 19.4 6.5 25.2 7.5 31C7.8 32.5 9.5 32.3 9.4 30.8C8.9 25.2 9.5 19.8 11 15.3C11.5 13.8 9.2 12.9 8.6 14.4Z';
const SPARK = 'M16 17.4L17.5 21.2L21.3 22.7L17.5 24.2L16 28L14.5 24.2L10.7 22.7L14.5 21.2Z';

const svgI = (d, extra = '') => `<svg class="i${extra}" viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`;
const IC = {
  plus: svgI('<path d="M12 5v14M5 12h14"/>'),
  close: svgI('<path d="M6 6l12 12M18 6 6 18"/>'),
  gift: svgI('<rect x="3.5" y="8.5" width="17" height="4.5" rx="1"/><path d="M5.5 13v6.5h13V13M12 8.5v11M12 8.5C9.6 8.5 7.6 7.7 7.6 6.1c0-1.4 1.5-2.3 2.9-1.3C11.4 5.4 12 7 12 8.5Zm0 0c2.4 0 4.4-.8 4.4-2.4 0-1.4-1.5-2.3-2.9-1.3C12.6 5.4 12 7 12 8.5Z"/>'),
  chat: svgI('<path d="M20 11.6a8 8 0 0 1-11.7 7.1L4 20l1.3-4A8 8 0 1 1 20 11.6Z"/><path d="M9 10.5h6M9 13.5h4"/>'),
  undo: svgI('<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>', ' flip'),
  copy: svgI('<rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M15 9V6.5A2.5 2.5 0 0 0 12.5 4h-6A2.5 2.5 0 0 0 4 6.5v6A2.5 2.5 0 0 0 6.5 15H9"/>'),
  edit: svgI('<path d="M4 20h4L19 9a2.1 2.1 0 0 0-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/>'),
  trash: svgI('<path d="M4 7h16M10 11v6M14 11v6M6 7l1 12.5h10L18 7M9 7V4.5h6V7"/>'),
};

const TPLS = [
  { k: 'visit', label: 'אחרי טיפול' },
  { k: 'status', label: 'מצב הכרטיסייה' },
  { k: 'reminder', label: 'תזכורת לתור' },
  { k: 'welcome', label: 'הודעת הצטרפות' },
  { k: 'redeem', label: 'אחרי טיפול מתנה' },
];
const UNDO_LABEL = { punch: 'ביטול ניקוב', redeem: 'ביטול מימוש', adjust: 'ביטול עדכון' };

const S = {
  db: null, status: 'loading', slow: false, canWrite: true,
  clients: new Map(), settings: normSettings(null),
  filter: 'all', q: '', stack: [], justPainted: null, lastPunch: null,
  unsubC: null, unsubS: null,
};

/* ---------- helpers ---------- */
const $ = (sel, r = document) => r.querySelector(sel);
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
const sleep = ms => new Promise(r => setTimeout(r, ms));
const num = (v, d = 0) => (Number.isFinite(v) ? v : d);
const gw = (c, f, m) => (c && c.g === 'm' ? m : f);
const firstName = n => (String(n || '').trim().split(/\s+/)[0] || String(n || ''));
const plural = (n, one, many) => (n === 1 ? one : `${n} ${many}`);
let uidSeq = 0;

function normSettings(d) {
  d = d || {};
  const n = Math.round(Number(d.cardSize));
  return {
    studioName: typeof d.studioName === 'string' ? d.studioName.trim().slice(0, 40) : DEFAULTS.studioName,
    cardSize: Number.isFinite(n) && n >= 3 && n <= 12 ? n : DEFAULTS.cardSize,
    ownerPhone: typeof d.ownerPhone === 'string' ? d.ownerPhone.trim().slice(0, 20) : DEFAULTS.ownerPhone,
    siteUrl: typeof d.siteUrl === 'string' ? d.siteUrl.trim().slice(0, 200) : DEFAULTS.siteUrl,
  };
}
function cardLink(c) {
  let base = S.settings.siteUrl.replace(/[#?].*$/, '').replace(/\/+$/, '');
  if (!base) return '';
  if (!/^https?:\/\//i.test(base)) base = 'https://' + base;
  const N = S.settings.cardSize, p = Math.min(c.punches, N), no = c.rewards + 1;
  // a claude.ai page reads the card from the #hash; the public card pages read it from the path, which WhatsApp turns into a card image
  if (/claude\.ai\/(code\/)?artifact\//i.test(base)) return `${base}#k${p}-${N}-${no}`;
  return `${base}/k/${N}/${p}/?c=${no}`;
}
function normClient(id, d) {
  const int0 = v => (Number.isFinite(v) ? Math.max(0, Math.floor(v)) : 0);
  return {
    id,
    name: typeof d.name === 'string' && d.name.trim() ? d.name.trim().slice(0, 40) : 'ללא שם',
    phone: typeof d.phone === 'string' ? d.phone.trim().slice(0, 20) : '',
    g: d.g === 'm' ? 'm' : 'f',
    notes: typeof d.notes === 'string' ? d.notes.slice(0, 300) : '',
    punches: int0(d.punches), rewards: int0(d.rewards), visits: int0(d.visits),
    createdAt: num(d.createdAt, 0),
    lastVisit: Number.isFinite(d.lastVisit) ? d.lastVisit : null,
    updatedAt: num(d.updatedAt, 0),
    log: Array.isArray(d.log) ? d.log.filter(e => e && Number.isFinite(e.t) && typeof e.a === 'string').slice(-LOG_MAX) : [],
  };
}
function toDoc(c) { const { id, ...rest } = c; return JSON.parse(JSON.stringify(rest)); }

function hex2rgb(h) { const n = parseInt(h.slice(1), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; }
function shade(i, N) {
  const t = N <= 1 ? 1 : i / (N - 1);
  const x = t * (STOPS.length - 1);
  const k = Math.min(STOPS.length - 2, Math.floor(x));
  const f = x - k, a = hex2rgb(STOPS[k]), b = hex2rgb(STOPS[k + 1]);
  return '#' + a.map((v, j) => Math.round(v + (b[j] - v) * f).toString(16).padStart(2, '0')).join('');
}
function avatarColors(name) {
  let h = 0; for (const ch of String(name)) h = (h * 31 + ch.codePointAt(0)) >>> 0;
  const idx = h % STOPS.length;
  return { bg: STOPS[idx], ink: idx >= 4 ? '#FFFFFF' : '#3A1F2B' };
}

function localDigits(p) {
  let d = String(p || '').replace(/\D/g, '');
  if (d.startsWith('00')) d = d.slice(2);
  if (d.startsWith('972')) d = '0' + d.slice(3);
  return d;
}
function fmtPhone(p) {
  const d = localDigits(p);
  if (/^05\d{8}$/.test(d)) return `${d.slice(0, 3)}-${d.slice(3, 6)}-${d.slice(6)}`;
  if (/^0[2-9]\d{7}$/.test(d)) return `${d.slice(0, 2)}-${d.slice(2, 5)}-${d.slice(5)}`;
  return String(p || '').trim();
}
function waNumber(p) {
  let d = String(p || '').replace(/\D/g, '');
  if (!d) return '';
  if (d.startsWith('00')) d = d.slice(2);
  if (d.startsWith('972')) return d;
  if (d.startsWith('0')) return '972' + d.slice(1);
  if (d.length === 9 && d.startsWith('5')) return '972' + d;
  return d;
}
function waHref(phone, text) { return `https://wa.me/${waNumber(phone)}?text=${encodeURIComponent(text)}`; }

function rel(ms) {
  if (!ms) return '';
  const a = new Date(); a.setHours(0, 0, 0, 0);
  const b = new Date(ms); b.setHours(0, 0, 0, 0);
  const days = Math.round((a - b) / DAY);
  if (days <= 0) return 'היום';
  if (days === 1) return 'אתמול';
  if (days === 2) return 'שלשום';
  if (days < 14) return `לפני ${days} ימים`;
  if (days < 21) return 'לפני שבועיים';
  if (days < 30) return 'לפני 3 שבועות';
  if (days < 60) return 'לפני חודש';
  if (days < 90) return 'לפני חודשיים';
  return `לפני ${Math.floor(days / 30)} חודשים`;
}
const fmtDate = ms => new Date(ms).toLocaleDateString('he-IL', { day: 'numeric', month: 'numeric', year: '2-digit' });
const isAway = c => { const ref = c.lastVisit || c.createdAt; return !!ref && Date.now() - ref > AWAY_DAYS * DAY; };
const lastSeen = c => (c.lastVisit ? rel(c.lastVisit) : 'טרם נרשם ביקור');
const studioName = () => S.settings.studioName;

function monthStats() {
  const s = new Date(); s.setDate(1); s.setHours(0, 0, 0, 0);
  const from = s.getTime();
  let visits = 0, gifts = 0;
  S.clients.forEach(c => c.log.forEach(e => {
    if (e.t < from) return;
    if (e.a === 'punch') visits++;
    else if (e.a === 'redeem') { visits++; gifts++; }
  }));
  return { visits, gifts };
}

/* ---------- nails ---------- */
function nail(kind, o = {}) {
  const cls = o.cls ? ' ' + o.cls : '';
  if (kind === 'full') {
    return `<svg class="nail${cls}" viewBox="0 0 32 44" aria-hidden="true"><path class="edge" d="${NAIL}" style="fill:${o.color}"/><path d="${SHINE}" fill="#fff" opacity=".5"/><ellipse cx="12.6" cy="8.8" rx="1" ry="1.6" fill="#fff" opacity=".55"/></svg>`;
  }
  if (kind === 'empty') {
    return `<svg class="nail${cls}" viewBox="0 0 32 44" aria-hidden="true"><path class="slot" d="${NAIL}"/>${o.n ? `<text class="num" x="16" y="29.5">${o.n}</text>` : ''}</svg>`;
  }
  if (kind === 'gift-on') {
    return `<svg class="nail gift-ready${cls}" viewBox="0 0 32 44" aria-hidden="true"><path class="edge" d="${NAIL}" fill="url(#chrome)"/><path d="${SHINE}" fill="#fff" opacity=".75"/><path class="spark-on" d="${SPARK}"/></svg>`;
  }
  return `<svg class="nail${cls}" viewBox="0 0 32 44" aria-hidden="true"><path class="slot" d="${NAIL}"/><path class="spark-off" d="${SPARK}"/></svg>`;
}
function nailRow(p, N, size, paintIdx = -1) {
  const f = Math.min(p, N), full = p >= N;
  let out = '';
  for (let i = 0; i < N; i++) {
    if (i < f) {
      const col = shade(i, N);
      out += i === paintIdx && size === 'big'
        ? `<span class="nailbox">${nail('empty', { n: i + 1 })}${nail('full', { color: col, cls: 'painting' })}</span>`
        : nail('full', { color: col });
    } else {
      out += nail('empty', { n: size === 'big' ? i + 1 : '' });
    }
  }
  out += nail(full ? 'gift-on' : 'gift-off');
  const total = N + 1;
  let attrs = '';
  let cls = `nails ${size}`;
  if (size === 'big') {
    const cols = total <= 7 ? total : Math.ceil(total / 2);
    attrs = ` style="grid-template-columns:repeat(${cols},auto)"`;
    if (total > 7) cls += ' dense';
  }
  const label = full ? `הכרטיסייה מלאה, ${N} מתוך ${N}` : `${f} מתוך ${N} ניקובים`;
  return `<div class="${cls}" role="img" aria-label="${label}"${attrs}>${out}</div>`;
}

/* ---------- messages ---------- */
function progressLines(p, N) {
  const f = Math.min(p, N), RLM = '‏';
  const cells = [];
  for (let i = 0; i < N; i++) cells.push(i < f ? '💖' : '🤍');
  if (N <= 8) return RLM + cells.join('') + ' 🎁';
  const half = Math.ceil(N / 2);
  return RLM + cells.slice(0, half).join('') + '\n' + RLM + cells.slice(half).join('') + ' 🎁';
}
function statusLine(p, N) {
  const f = Math.min(p, N), left = N - f;
  if (p <= 0) return 'הניקוב הראשון מחכה לך בטיפול הבא ✨';
  if (left <= 0) return '*הכרטיסייה מלאה!* הטיפול הבא שלך מתנה ממני 🎁';
  return `*${f} מתוך ${N}* · עוד ${left === 1 ? 'טיפול אחד' : left + ' טיפולים'} ואז טיפול מתנה ממני 🎁`;
}
function buildMessage(tpl, c) {
  const N = S.settings.cardSize, p = c.punches, name = firstName(c.name), studio = studioName();
  const prog = progressLines(p, N), st = statusLine(p, N);
  const link = cardLink(c);
  const sig = (link ? `\n\nלצפייה בכרטיסייה שלך:\n${link}` : '') + (studio ? `\n\n${studio} 💅` : '');
  switch (tpl) {
    case 'welcome':
      return `היי ${name} 💕\n${gw(c, 'ברוכה הבאה', 'ברוך הבא')} לכרטיסיית המועדון שלי!\nעל כל טיפול ${gw(c, 'את מקבלת', 'אתה מקבל')} ניקוב, ואחרי ${N} טיפולים הטיפול הבא מתנה ממני 🎁\n\nהכרטיסייה שלך:\n${prog}\n${st}${sig}`;
    case 'visit':
      if (p >= N) return `היי ${name} 🎉\nתודה שבאת היום! הכרטיסייה שלך התמלאה:\n${prog}\n*הטיפול הבא שלך מתנה ממני* 🎁 מחכה לפנק אותך!${sig}`;
      return `היי ${name} 💕\nתודה שבאת היום ✨\nהוספתי לך ניקוב בכרטיסייה:\n${prog}\n${st}${sig}`;
    case 'redeem':
      return `היי ${name} 💝\n${gw(c, 'תתחדשי', 'תתחדש')} על טיפול המתנה! תודה ש${gw(c, 'את', 'אתה')} איתי 💕\nפתחתי לך כרטיסייה חדשה:\n${prog}\n${st}${sig}`;
    case 'reminder':
      return `היי ${name} 💕\nמתגעגעת! עבר קצת זמן מאז הטיפול האחרון, אולי הגיע הזמן לחדש את הציפורניים? 💅\n\n${prog}\n${st}\n\nלקביעת תור אפשר פשוט להשיב להודעה הזו ✨${link ? `\nהכרטיסייה שלך: ${link}` : ''}${studio ? `\n${studio}` : ''}`;
    default:
      return `היי ${name} 💕\nעדכון מהכרטיסייה שלך:\n${prog}\n${st}${sig}`;
  }
}
function buildSummary() {
  const N = S.settings.cardSize;
  const list = [...S.clients.values()].sort((a, b) => a.name.localeCompare(b.name, 'he'));
  const gifts = list.filter(c => c.punches >= N), away = list.filter(isAway), m = monthStats();
  const date = new Date().toLocaleDateString('he-IL', { day: 'numeric', month: 'numeric', year: 'numeric' });
  let t = `📋 *סיכום כרטיסיות${studioName() ? ' · ' + studioName() : ''}*\n${date}\n${plural(list.length, 'לקוחה אחת', 'לקוחות')} · ${plural(m.visits, 'טיפול אחד', 'טיפולים')} החודש`;
  if (gifts.length) t += `\n\n🎁 *מתנה מוכנה (${gifts.length})*\n` + gifts.map(c => `• ${c.name}`).join('\n');
  if (away.length) t += `\n\n⏳ *מזמן לא הגיעו (${away.length})*\n` + away.map(c => `• ${c.name} · ${lastSeen(c)}`).join('\n');
  if (list.length) {
    const MAX = 60;
    t += `\n\n💅 *כל הכרטיסיות*\n` + list.slice(0, MAX).map(c => `• ${c.name} · ${Math.min(c.punches, N)}/${N}`).join('\n');
    if (list.length > MAX) t += `\nועוד ${list.length - MAX}`;
  }
  return t;
}
function fmtWa(text) {
  return esc(text)
    .replace(/\*([^*\n]+)\*/g, '<b>$1</b>')
    .replace(/(^|\s)_([^_\n]+)_/g, '$1<i>$2</i>');
}
function defaultTpl(c) {
  const last = c.log[c.log.length - 1];
  if (last && Date.now() - last.t < 12 * 3600e3) {
    if (last.a === 'punch') return 'visit';
    if (last.a === 'redeem') return 'redeem';
    if (last.a === 'join') return 'welcome';
  }
  return isAway(c) ? 'reminder' : 'status';
}

/* ---------- rendering ---------- */
function pcardHTML(c, paintIdx) {
  const N = S.settings.cardSize, f = Math.min(c.punches, N), full = c.punches >= N, left = N - f;
  const status = full
    ? '<b>הכרטיסייה מלאה</b> · הטיפול הבא מתנה'
    : c.punches <= 0
      ? `כרטיסייה חדשה · ${N} טיפולים עד המתנה`
      : `<b>${f} מתוך ${N}</b> · עוד ${left === 1 ? 'טיפול אחד' : left + ' טיפולים'} עד טיפול מתנה`;
  return `<article class="pcard${full ? ' is-full' : ''}">
    ${ROSE_SVG}
    <div class="pcard-top">
      <div><div class="pcard-eyebrow">${MARK_SVG}<span>כרטיסיית מועדון</span></div><div class="pcard-studio" dir="ltr">sapinails.il</div></div>
    </div>
    ${nailRow(c.punches, N, 'big', paintIdx)}
    <div class="pcard-foot">
      <div class="pcard-who"><div class="pcard-name">${esc(c.name)}</div><div class="pcard-status">${status}</div></div>
      <div class="pcard-no">כרטיסייה מס׳ ${c.rewards + 1}</div>
    </div>
  </article>`;
}

function rowHTML(c) {
  const N = S.settings.cardSize, full = c.punches >= N, f = Math.min(c.punches, N);
  const av = avatarColors(c.name), init = [...c.name.trim()][0] || '?';
  const quick = full
    ? `<button type="button" class="punch-quick gift" data-act="open" data-id="${esc(c.id)}" aria-label="${esc('מימוש טיפול מתנה ל' + c.name)}">${IC.gift}</button>`
    : `<button type="button" class="punch-quick" data-act="qpunch" data-id="${esc(c.id)}" aria-label="${esc('ניקוב טיפול ל' + c.name)}"${S.canWrite ? '' : ' disabled'}>${IC.plus}</button>`;
  return `<li class="row">
    <button type="button" class="row-main" data-act="open" data-id="${esc(c.id)}">
      <span class="avatar" style="--av:${av.bg};--av-ink:${av.ink}" aria-hidden="true">${esc(init)}</span>
      <span class="row-text">
        <span class="row-name"><span class="nm">${esc(c.name)}</span>${full ? '<span class="pill gift">מתנה מוכנה</span>' : ''}</span>
        <span class="row-meta">${nailRow(c.punches, N, 'mini')}<span class="count">${f}/${N}</span><span class="when${isAway(c) ? ' away' : ''}">${esc(lastSeen(c))}</span></span>
      </span>
    </button>
    ${quick}
  </li>`;
}

function visibleClients() {
  const N = S.settings.cardSize, q = S.q.trim().toLowerCase(), qd = q.replace(/\D/g, '');
  let arr = [...S.clients.values()];
  if (S.filter === 'gift') arr = arr.filter(c => c.punches >= N);
  if (S.filter === 'away') arr = arr.filter(isAway);
  if (q) arr = arr.filter(c => c.name.toLowerCase().includes(q) || (qd.length >= 3 && localDigits(c.phone).includes(qd)));
  const ref = c => c.lastVisit || c.createdAt || 0;
  if (S.filter === 'away') arr.sort((a, b) => ref(a) - ref(b));
  else arr.sort((a, b) => ref(b) - ref(a) || a.name.localeCompare(b.name, 'he'));
  return arr;
}

