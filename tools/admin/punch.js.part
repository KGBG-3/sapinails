5 -6C15 -7 16 -7 16 -8C16 -8 17 -9 17 -9C17 -10 18 -11 18 -11"></path></g><path d="M-3 4C-2 4 -1 2 0 2C0 1 1 0 1 -1C1 -2 2 -3 2 -4C2 -5 2 -6 2 -7C2 -7 2 -8 1 -9C0 -10 -1 -10 -2 -11C-4 -12 -5 -12 -6 -13C-7 -14 -8 -15 -9 -15C-9 -16 -10 -17 -11 -18C-11 -18 -12 -19 -13 -20C-13 -21 -13 -21 -14 -22C-14 -23 -14 -23 -14 -24C-14 -25 -14 -26 -14 -26C-14 -27 -14 -27 -13 -28C-13 -28 -13 -29 -12 -29C-11 -29 -11 -29 -10 -29C-9 -29 -7 -29 -6 -28C-6 -28 -5 -26 -5 -24C-4 -22 -4 -21 -4 -19C-3 -17 -3 -16 -3 -14C-3 -12 -4 -11 -4 -9C-4 -7 -5 -4 -5 -2C-5 -1 -6 -1 -6 -1C-6 0 -6 1 -5 1C-5 2 -5 2 -4 3C-4 3 -3 4 -3 4Z" fill="currentColor" stroke="none"></path><path d="M1 -1C1 -2 2 -3 2 -4C2 -5 2 -6 2 -7C2 -7 2 -8 1 -9C0 -10 -1 -10 -2 -11C-4 -12 -5 -12 -6 -13C-7 -14 -8 -15 -9 -15C-9 -16 -10 -17 -11 -18C-11 -18 -12 -19 -13 -20C-13 -21 -13 -21 -14 -22C-14 -23 -14 -23 -14 -24C-14 -25 -14 -26 -14 -26C-14 -27 -14 -27 -13 -28C-13 -28 -13 -29 -12 -29C-11 -29 -11 -29 -10 -29C-9 -29 -7 -29 -6 -28C-6 -28 -5 -26 -5 -24C-4 -22 -4 -21 -4 -19C-3 -17 -3 -15 -3 -14"></path><path d="M6 3C7 2 8 -1 9 -3C10 -4 10 -6 11 -8C12 -9 12 -11 13 -12C13 -13 14 -15 14 -16C15 -17 16 -18 16 -18C16 -18 16 -17 16 -17C16 -16 15 -16 15 -15C14 -15 14 -14 13 -14C12 -14 11 -13 11 -13C10 -12 9 -12 8 -12C7 -11 6 -11 5 -11C4 -10 3 -10 2 -10C1 -10 -1 -10 -2 -10C-3 -10 -4 -10 -5 -10C-6 -10 -7 -10 -8 -11C-9 -11 -10 -11 -11 -11C-12 -12 -13 -12 -13 -12C-13 -12 -13 -11 -12 -10C-12 -9 -11 -8 -11 -7C-10 -6 -10 -5 -9 -3C-9 -2 -8 -1 -7 1C-6 2 -4 4 -3 5C-2 6 -2 6 -1 6C0 6 1 6 2 6C3 5 4 5 4 5C5 4 5 5 6 3Z" fill="currentColor" stroke="none"></path><path d="M11 -8C11 -8 12 -11 13 -12C13 -13 14 -15 14 -16C15 -17 16 -18 16 -18C16 -18 16 -17 16 -17C16 -16 15 -16 15 -15C14 -15 14 -14 13 -14C12 -14 11 -13 11 -13C10 -12 9 -12 8 -12C7 -11 6 -11 5 -11C4 -10 3 -10 2 -10C1 -10 -1 -10 -2 -10C-3 -10 -4 -10 -5 -10C-6 -10 -7 -10 -8 -11C-9 -11 -10 -11 -11 -11C-12 -12 -13 -12 -13 -12C-13 -12 -13 -11 -12 -10C-12 -9 -11 -8 -11 -7C-10 -6 -9 -4 -9 -3"></path><path d="M12 1C13 -1 15 -4 16 -6C17 -8 18 -9 20 -11C21 -12 22 -14 24 -15C25 -16 27 -17 28 -18C30 -19 33 -20 34 -20C36 -20 36 -18 37 -17C37 -16 37 -15 37 -14C37 -13 38 -12 38 -11C37 -9 37 -8 37 -7C36 -6 36 -5 35 -5C34 -4 33 -3 32 -2C31 -1 31 0 30 0C29 1 28 2 26 3C25 3 24 4 22 4C21 5 19 5 17 6C15 6 14 7 12 7C10 7 7 8 6 8C4 8 2 7 1 7C0 7 0 7 0 7C-1 7 -1 8 -1 8C0 8 0 8 1 9C1 9 2 9 3 9C4 9 6 8 7 8C8 7 8 7 9 6C10 5 11 4 11 4C12 3 11 2 12 1Z" fill="currentColor" stroke="none"></path><path d="M16 -6C16 -6 18 -9 20 -11C21 -12 22 -14 24 -15C25 -16 27 -17 28 -18C30 -19 33 -20 34 -20C36 -20 36 -18 37 -17C37 -16 37 -15 37 -14C37 -13 38 -12 38 -11C37 -9 37 -8 37 -7C36 -6 36 -5 35 -5C34 -4 33 -3 32 -2C31 -1 31 0 30 0C29 1 28 2 26 3C25 3 24 4 22 4C21 5 19 5 17 6C15 6 14 7 12 7C10 7 7 8 6 8C4 8 2 7 1 7C0 7 0 7 0 7C-1 7 -1 8 -1 8C0 8 0 8 1 9"></path><path stroke-width="1" d="M29 -16C29 -15 28 -14 28 -13C28 -12 28 -11 28 -10C27 -9 27 -8 27 -7C26 -7 26 -6 25 -5C24 -4 24 -3 23 -2C22 -2 21 -1 21 0C20 1 19 1 18 2C17 2 16 3 15 4C14 4 13 5 11 5C10 5 9 6 8 6C7 6 5 7 4 7"></path><path d="M0 8C2 8 3 6 4 6C5 5 6 4 7 4C7 3 8 3 8 2C8 2 8 1 8 1C8 1 8 1 7 1C6 1 4 1 2 1C0 1 -1 1 -3 1C-4 1 -6 1 -7 1C-9 0 -10 0 -12 0C-13 -1 -14 -1 -15 -1C-16 -2 -17 -2 -18 -3C-19 -3 -21 -4 -21 -5C-22 -5 -23 -6 -24 -7C-25 -7 -26 -8 -26 -9C-27 -10 -27 -11 -27 -12C-27 -13 -28 -13 -28 -14C-28 -15 -27 -16 -27 -17C-26 -17 -24 -16 -23 -15C-22 -14 -21 -13 -20 -12C-18 -11 -17 -10 -16 -8C-15 -7 -14 -5 -13 -3C-12 -1 -10 1 -10 3C-9 4 -9 4 -8 5C-7 5 -7 6 -6 7C-5 7 -4 7 -3 8C-2 8 -1 8 0 8Z" fill="currentColor" stroke="none"></path><path d="M7 4C7 3 8 3 8 2C8 2 8 1 8 1C8 1 8 1 7 1C6 1 4 1 2 1C0 1 -1 1 -3 1C-4 1 -6 1 -7 1C-9 0 -10 0 -12 0C-13 -1 -14 -1 -15 -1C-16 -2 -17 -2 -18 -3C-19 -3 -21 -4 -21 -5C-22 -5 -23 -6 -24 -7C-25 -7 -26 -8 -26 -9C-27 -10 -27 -11 -27 -12C-27 -13 -28 -13 -28 -14C-28 -15 -27 -16 -27 -17C-26 -17 -24 -16 -23 -15C-22 -14 -21 -13 -20 -12C-18 -11 -17 -9 -16 -8"></path><g stroke-width="1"><path d="M5 2C5 2 3 2 2 2C1 2 0 2 -1 2C-2 2 -4 2 -5 2C-6 1 -7 1 -8 1C-9 1 -10 0 -11 0C-12 -1 -13 -1 -14 -2C-15 -2 -16 -3 -17 -4C-17 -4 -18 -5 -19 -6C-19 -6 -20 -7 -20 -8C-21 -9 -21 -9 -22 -10C-22 -11 -22 -12 -23 -13"></path><path d="M-7 3C-7 3 -7 2 -7 2C-8 2 -8 2 -8 2C-8 1 -9 1 -9 1"></path><path d="M-5 3C-5 3 -5 3 -5 3C-5 3 -5 3 -5 2C-5 2 -6 2 -6 2"></path><path d="M-2 4C-2 4 -2 4 -2 3C-2 3 -2 3 -2 3C-2 3 -2 2 -2 2"></path></g><path d="M7 10C8 10 11 9 13 10C15 10 16 10 18 10C19 10 20 10 21 11C22 12 23 13 24 14C24 16 25 18 24 20C24 22 21 23 20 24C18 25 17 25 15 26C13 27 12 28 10 29C9 30 7 30 5 30C4 31 2 31 1 31C-1 31 -3 30 -4 30C-6 29 -7 30 -9 30C-11 29 -12 29 -14 28C-15 28 -17 27 -18 26C-20 25 -21 23 -23 22C-24 21 -25 20 -27 19C-28 18 -30 16 -30 14C-30 13 -29 11 -28 10C-27 9 -25 9 -24 8C-23 8 -22 8 -20 8C-18 8 -17 8 -15 8C-13 8 -10 9 -9 9C-7 9 -6 10 -5 10C-4 11 -2 11 -1 11C0 11 2 11 3 11C4 11 5 10 7 10Z" fill="currentColor" stroke="none"></path><path d="M13 10C14 10 16 10 18 10C19 10 20 10 21 11C22 12 23 13 24 14C24 16 25 18 24 20C24 22 21 23 20 24C18 25 17 25 15 26C13 27 12 28 10 29C9 30 7 30 5 30C4 31 2 31 1 31C-1 31 -3 30 -4 30C-6 29 -7 30 -9 30C-11 29 -12 29 -14 28C-15 28 -17 27 -18 26C-20 25 -21 23 -23 22C-24 21 -25 20 -27 19C-28 18 -30 16 -30 14C-30 13 -29 11 -28 10C-27 9 -25 9 -24 8C-23 8 -22 8 -20 8C-18 8 -16 8 -15 8"></path><g stroke-width="1"><path d="M20 15C20 15 18 16 16 16C15 16 14 17 12 17C11 18 9 18 8 18C6 18 5 18 4 18C2 19 1 19 -1 19C-2 19 -4 18 -5 18C-7 18 -8 18 -10 18C-11 18 -12 17 -14 17C-15 16 -16 16 -18 16C-19 15 -20 14 -22 14C-23 14 -25 13 -25 13"></path><path d="M2 15C2 15 2 16 2 16C3 16 3 16 3 16C3 17 3 17 3 17"></path><path d="M5 15C5 15 5 16 5 16C5 16 5 16 5 16C5 16 5 17 5 17"></path><path d="M9 15C9 15 9 15 9 15C9 16 9 16 9 16C10 16 10 16 10 16"></path><path d="M11 14C11 14 12 14 12 14C12 15 12 15 12 15C12 15 12 15 13 15"></path><path d="M14 13C14 13 15 13 15 13C15 13 16 14 16 14C16 14 16 14 17 14"></path></g></g></svg>';
const MARK_SVG = '<svg viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path class="mk" d="M36 17C40 17 50 18 57 18C64 19 72 19 79 19C86 19 93 18 100 18C107 18 114 18 121 17C128 17 136 17 143 17C150 17 157 17 164 17C171 17 178 18 185 18C193 18 200 18 207 18C214 19 221 18 228 18C235 18 242 17 249 17C257 16 264 15 271 15C278 14 285 13 292 13C299 12 306 12 314 12C321 11 328 11 335 11C342 12 349 12 356 12C363 12 370 13 378 13C385 13 392 13 399 13C406 13 413 13 420 13C427 13 434 13 442 12C449 12 456 12 463 12C470 12 477 12 484 13C491 13 498 13 506 14C513 15 520 15 527 16C534 16 541 17 548 18C555 18 563 18 570 18C577 18 587 15 591 18C595 20 595 26 596 32C598 38 599 45 599 52C598 59 596 66 595 72C593 78 595 83 591 85C587 88 577 87 570 87C563 88 555 89 548 89C541 89 534 90 527 90C520 90 513 90 506 90C498 90 491 90 484 90C477 89 470 89 463 89C456 88 449 88 442 88C434 88 427 88 420 88C413 88 406 88 399 88C392 88 385 88 378 88C370 88 363 89 356 89C349 89 342 88 335 88C328 88 321 88 314 87C306 87 299 86 292 86C285 85 278 84 271 84C264 84 257 83 249 83C242 83 235 83 228 83C221 83 214 83 207 84C200 84 193 85 185 85C178 86 171 86 164 86C157 87 150 87 143 87C136 88 128 88 121 88C114 88 107 88 100 88C93 87 86 87 79 87C72 87 64 87 57 88C50 88 40 88 36 88L28 82L45 76L28 67L43 62L19 55L39 48L32 40L42 34L26 24L42 19Z"></path><path d="M59 40C59 40 104 39 127 39C149 39 194 40 194 40C194 41 149 42 127 42C104 42 59 41 59 40ZM107 70C107 70 144 69 163 69C181 69 218 70 218 70C218 71 181 72 163 72C144 72 107 71 107 70Z" fill="#fff" opacity=".2"></path></svg>';
const EXAMPLE = { id: 'example', name: 'נועה לוי', punches: 4, rewards: 1, g: 'f' };
function emptyHTML() {
  const canAdd = S.status === 'ready' && S.canWrite;
  return `<section class="empty">
    <div class="example"><span class="example-tag">דוגמה</span>${pcardHTML(EXAMPLE, -1)}</div>
    <div class="empty-copy">
      <h2 class="empty-title">${S.status === 'ready' ? 'הכרטיסייה מוכנה ללקוחה הראשונה' : 'ככה עובדת הכרטיסייה'}</h2>
      <ol class="steps">
        <li><span><b>מוסיפים לקוחה</b> עם שם וטלפון.</span></li>
        <li><span><b>אחרי כל טיפול לוחצים ניקוב.</b> כשהכרטיסייה מתמלאת, הטיפול הבא מתנה.</span></li>
        <li><span><b>שולחים לה עדכון בוואטסאפ</b> עם מצב הכרטיסייה, בלחיצה אחת.</span></li>
      </ol>
      ${canAdd ? `<button type="button" class="btn primary big" data-act="add">${IC.plus}<span>הוספת לקוחה ראשונה</span></button>` : ''}
    </div>
  </section>`;
}

function renderHeader() {
  const name = studioName();
  $('#studio').textContent = name || 'כרטיסיית מועדון';
  $('#eyebrow').hidden = !name;
  let sub = '';
  if (S.status === 'ready') {
    const m = monthStats();
    const month = new Intl.DateTimeFormat('he-IL', { month: 'long' }).format(new Date());
    sub = m.visits === 0
      ? `עוד אין טיפולים ב${month}`
      : `${plural(m.visits, 'טיפול אחד', 'טיפולים')} ב${month}${m.gifts ? ' · ' + plural(m.gifts, 'מתנה אחת', 'מתנות') : ''}`;
  }
  $('#sub').textContent = sub;
}
function renderBanner() {
  const b = $('#banner');
  let html = '';
  if (S.status === 'nodb') html = '<strong>רשימת הלקוחות לא נטענה בתצוגה הזו.</strong> הנתונים נשמרים בתוך Claude, ולכן הכרטיסייה עובדת כשפותחים את הדף מתוך Claude, בחשבון שקיבל גישה אליו.';
  else if (S.status === 'ready' && !S.canWrite) html = '<strong>מצב צפייה בלבד.</strong> כדי לנקב ולעדכן לקוחות צריך הרשאת עריכה בדף.';
  else if (S.status === 'loading' && S.slow) html = 'הטעינה לוקחת יותר זמן מהרגיל. אם זה נמשך, כדאי לרענן את הדף.';
  b.hidden = !html;
  if (b._last !== html) { b.innerHTML = html; b._last = html; }
}
function renderToolbar() {
  const show = S.status === 'ready' && S.clients.size > 0;
  $('#toolbar').hidden = !show;
  if (!show) return;
  const N = S.settings.cardSize;
  let gift = 0, away = 0;
  S.clients.forEach(c => { if (c.punches >= N) gift++; if (isAway(c)) away++; });
  $('#n-all').textContent = S.clients.size;
  $('#n-gift').textContent = gift;
  $('#n-away').textContent = away;
  document.querySelectorAll('.toolbar .chip').forEach(ch => ch.setAttribute('aria-pressed', String(ch.dataset.f === S.filter)));
}
function renderMain() {
  const m = $('#main');
  let html;
  if (S.status === 'loading') {
    html = '<div class="skel-list" aria-hidden="true"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>';
  } else if (S.status === 'nodb' || S.clients.size === 0) {
    html = emptyHTML();
  } else {
    const arr = visibleClients();
    if (arr.length) html = `<ul class="list">${arr.map(rowHTML).join('')}</ul>`;
    else {
      const msg = S.q.trim() ? `לא נמצאה לקוחה שמתאימה ל„${S.q.trim()}”.`
        : S.filter === 'gift' ? 'אין כרגע כרטיסיות מלאות.'
        : 'כל הלקוחות ביקרו בחמשת השבועות האחרונים.';
      html = `<div class="no-results">${esc(msg)}</div>`;
    }
  }
  if (m._last !== html) { m.innerHTML = html; m._last = html; }
}
function render() {
  renderHeader();
  renderBanner();
  renderToolbar();
  renderMain();
  updateSheets();
  $('#addBtn').hidden = S.stack.length > 0 || S.status !== 'ready' || !S.canWrite || S.clients.size === 0;
  root.classList.toggle('locked', S.stack.length > 0);
}

/* ---------- sheets ---------- */
const topSheet = () => S.stack[S.stack.length - 1];

function openSheet(spec) {
  if (spec.type === 'client') closeAll(true);
  spec.tid = 'st' + (++uidSeq);
  spec.prevFocus = document.activeElement;
  const layer = document.createElement('div');
  layer.className = 'layer';
  layer.style.zIndex = String(40 + S.stack.length);
  layer.innerHTML = `<div class="backdrop" data-act="close"></div><section class="sheet" role="dialog" aria-modal="true" aria-labelledby="${spec.tid}"><div class="grab" aria-hidden="true"></div><div class="sheet-inner"></div></section>`;
  spec.el = layer;
  spec.inner = layer.querySelector('.sheet-inner');
  spec.lastHTML = '';
  $('#sheets').appendChild(layer);
  S.stack.push(spec);
  fillSheet(spec, true);
  render();
  const focusEl = spec.type === 'edit' && !spec.id ? $('#f-name', spec.inner) : $('.sheet-title', spec.inner);
  if (focusEl) focusEl.focus({ preventScroll: true });
}
function closeTop() {
  const spec = S.stack.pop();
  if (!spec) return;
  spec.el.remove();
  render();
  if (spec.prevFocus && document.contains(spec.prevFocus)) spec.prevFocus.focus({ preventScroll: true });
}
function closeAll(silent) {
  while (S.stack.length) S.stack.pop().el.remove();
  if (!silent) render();
}
function updateSheets() { S.stack.forEach(spec => fillSheet(spec, false)); }

function fillSheet(spec, first) {
  let html;
  if (spec.type === 'client') html = clientSheetHTML(spec);
  else if (spec.type === 'wa') {
    if (!first && spec.editing) { updateWaLink(spec); return; }
    html = waSheetHTML(spec);
  } else if (first) {
    html = spec.type === 'edit' ? editFormHTML(spec) : settingsHTML(spec);
  } else return;
  if (html === spec.lastHTML) return;
  const body = $('.sheet-body', spec.inner);
  const top = body ? body.scrollTop : 0;
  spec.inner.innerHTML = html;
  spec.lastHTML = html;
  const nb = $('.sheet-body', spec.inner);
  if (nb && !first) nb.scrollTop = top;
}

function sheetHead(spec, title, extra = '') {
  return `<div class="sheet-head"><h2 class="sheet-title" id="${spec.tid}" tabindex="-1">${title}</h2>${extra}<button type="button" class="icon-btn" data-act="close" aria-label="סגירה">${IC.close}</button></div>`;
}

function histText(e, c, N) {
  switch (e.a) {
    case 'punch': return `ניקוב · ${Math.min(num(e.p), N)}/${N}`;
    case 'redeem': return 'טיפול מתנה מומש';
    case 'adjust': return `עדכון ידני ל־${num(e.p)} ניקובים`;
    case 'join': return num(e.p) > 0 ? `${gw(c, 'הצטרפה', 'הצטרף')} עם ${plural(num(e.p), 'ניקוב אחד', 'ניקובים')}` : `${gw(c, 'הצטרפה', 'הצטרף')} למועדון`;
    default: return '';
  }
}

function clientSheetHTML(spec) {
  const c = S.clients.get(spec.id);
  if (!c) return sheetHead(spec, 'הכרטיסייה לא נמצאה') + '<div class="sheet-body"><p class="help">ייתכן שהלקוחה נמחקה ממכשיר אחר.</p></div>';
  const N = S.settings.cardSize, full = c.punches >= N;
  const paintIdx = S.justPainted && S.justPainted.id === c.id ? S.justPainted.idx : -1;
  const last = c.log[c.log.length - 1];
  const undoLabel = last && last.prev && UNDO_LABEL[last.a];
  const recent = !!last && Date.now() - last.t < 3 * 60e3 && ['punch', 'redeem', 'join'].includes(last.a);
  const dis = S.canWrite ? '' : ' disabled';
  const id = esc(c.id);
  const primary = full
    ? `<button type="button" class="btn chrome big" data-act="redeem" data-id="${id}"${dis}>${IC.gift}<span>מימוש טיפול מתנה</span></button>`
    : `<button type="button" class="btn primary big" data-act="punch" data-id="${id}"${dis}>${IC.plus}<span>ניקוב טיפול</span></button>`;
  const waBtn = `<button type="button" class="btn wa${recent ? ' nudge' : ''}" data-act="wa" data-id="${id}">${IC.chat}<span>${recent ? 'שליחת עדכון' : 'וואטסאפ'}</span></button>`;
  const undoBtn = undoLabel ? `<button type="button" class="btn ghost" data-act="undo" data-id="${id}"${dis}>${IC.undo}<span>${undoLabel}</span></button>` : '';
  const phone = c.phone
    ? `<span class="phone" dir="ltr">${esc(fmtPhone(c.phone))}</span><button type="button" class="mini-btn" data-act="copy-phone" data-id="${id}">${IC.copy}<span>העתקה</span></button>`
    : '<span class="muted">לא הוזן</span>';
  const since = c.createdAt ? new Intl.DateTimeFormat('he-IL', { month: 'long', year: 'numeric' }).format(new Date(c.createdAt)) : '';
  const hist = c.log.slice(-12).reverse().map(e => `<li><span>${esc(histText(e, c, N))}</span><time>${fmtDate(e.t)}</time></li>`).join('');
  const del = spec.confirmDelete
    ? `<div class="confirm" role="alert"><p>${esc(`למחוק את ${c.name} מהכרטיסייה? כל הניקובים וההיסטוריה ${gw(c, 'שלה', 'שלו')} יימחקו.`)}</p><div class="actions-row"><button type="button" class="btn danger" data-act="delete-yes" data-id="${id}">מחיקה</button><button type="button" class="btn ghost" data-act="delete-no">ביטול</button></div></div>`
    : `<button type="button" class="text-btn danger-txt" data-act="delete-ask"${dis}>${IC.trash}<span>מחיקת ${gw(c, 'הלקוחה', 'הלקוח')}</span></button>`;
  return sheetHead(spec, esc(c.name), `<button type="button" class="head-btn" data-act="edit" data-id="${id}"${dis}>${IC.edit}<span>עריכה</span></button>`) +
    `<div class="sheet-body">
      ${pcardHTML(c, paintIdx)}
      <div class="actions">${primary}<div class="actions-row">${waBtn}${undoBtn}</div></div>
      <dl class="info">
        <div class="info-row"><dt>טלפון</dt><dd>${phone}</dd></div>
        <div class="info-row"><dt>ביקור אחרון</dt><dd>${esc(c.lastVisit ? rel(c.lastVisit) + ' · ' + fmtDate(c.lastVisit) : 'עוד לא נרשם')}</dd></div>
        <div class="info-row"><dt>סה״כ</dt><dd>${plural(c.visits, 'טיפול אחד', 'טיפולים')} · ${plural(c.rewards, 'מתנה אחת', 'מתנות')}</dd></div>
        ${since ? `<div class="info-row"><dt>במועדון מאז</dt><dd>${esc(since)}</dd></div>` : ''}
        ${c.notes ? `<div class="info-row notes"><dt>הערות</dt><dd>${esc(c.notes)}</dd></div>` : ''}
      </dl>
      ${hist ? `<section class="hist"><h3 class="sec-title">היסטוריה</h3><ol>${hist}</ol></section>` : ''}
      <div class="danger">${del}</div>
    </div>`;
}

function editFormHTML(spec) {
  const c = spec.id ? S.clients.get(spec.id) : null;
  const N = S.settings.cardSize;
  const v = { name: c ? c.name : '', phone: c ? c.phone : '', g: c ? c.g : 'f', notes: c ? c.notes : '', punches: c ? Math.min(c.punches, N) : 0 };
  return sheetHead(spec, c ? 'עריכת פרטים' : 'לקוחה חדשה') + `<div class="sheet-body">
    <form class="form" id="clientForm" novalidate>
      <div class="field">
        <label for="f-name">שם</label>
        <input class="input" id="f-name" name="name" autocomplete="off" enterkeyhint="next" maxlength="40" value="${esc(v.name)}">
        <div class="err" id="f-name-err" hidden>צריך שם כדי לשמור.</div>
      </div>
      <div class="field">
        <label for="f-phone">טלפון לוואטסאפ <span class="opt">(לא חובה)</span></label>
        <input class="input ltr" id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="off" dir="ltr" maxlength="20" placeholder="050-000-0000" value="${esc(v.phone)}">
        <div class="err" id="f-phone-err" hidden></div>
      </div>
      <fieldset class="field">
        <legend class="legend">פנייה בהודעות</legend>
        <div class="seg">
          <label><input type="radio" name="g" id="f-g-f" value="f"${v.g !== 'm' ? ' checked' : ''}><span>לשון נקבה</span></label>
          <label><input type="radio" name="g" id="f-g-m" value="m"${v.g === 'm' ? ' checked' : ''}><span>לשון זכר</span></label>
        </div>
      </fieldset>
      <div class="field">
        <span class="legend" id="f-p-l">ניקובים בכרטיסייה עכשיו</span>
        <div class="stepper" role="group" aria-labelledby="f-p-l">
          <button type="button" data-act="step" data-t="f-p" data-d="1" aria-label="ניקוב נוסף">+</button>
          <output id="f-p" data-min="0" data-max="${N}" aria-live="polite">${v.punches}</output>
          <button type="button" data-act="step" data-t="f-p" data-d="-1" aria-label="ניקוב אחד פחות">−</button>
          <span class="unit">מתוך ${N}</span>
        </div>
        <p class="help">${c ? 'לתיקון ידני בלבד. אחרי טיפול משתמשים בכפתור הניקוב.' : 'ללקוחות שכבר הגיעו אלייך לפני שהכרטיסייה התחילה.'}</p>
      </div>
      <div class="field">
        <label for="f-notes">הערות <span class="opt">(לא חובה)</span></label>
        <textarea class="input" id="f-notes" name="notes" rows="2" maxlength="300" placeholder="למשל: אוהבת גוונים ניוד, צורת שקד">${esc(v.notes)}</textarea>
      </div>
      <button type="submit" class="btn primary big" id="f-save">${c ? 'שמירת שינויים' : 'הוספה לכרטיסייה'}</button>
    </form>
  </div>`;
}

function cardHelp(n) {
  return `הטיפול ה־${n + 1} מתנה. ללקוחה שמגיעה פעם בחודש זו מתנה בערך כל ${n + 1} חודשים, הנחה אפקטיבית של כ־${Math.round(100 / (n + 1))}%.`;
}
function settingsHTML(spec) {
  const s = S.settings;
  return sheetHead(spec, 'הגדרות הכרטיסייה') + `<div class="sheet-body">
    <form class="form" id="settingsForm" novalidate>
      <div class="field">
        <label for="s-name">שם הסטודיו</label>
        <input class="input" id="s-name" autocomplete="off" maxlength="40" value="${esc(s.studioName)}">
        <p class="help">מופיע בראש הדף, על הכרטיסייה ובחתימה של ההודעות.</p>
      </div>
      <div class="field">
        <span class="legend" id="s-n-l">טיפולים בתשלום עד טיפול מתנה</span>
        <div class="stepper" role="group" aria-labelledby="s-n-l">
          <button type="button" data-act="step" data-t="s-n" data-d="1" aria-label="עוד טיפול">+</button>
          <output id="s-n" data-min="3" data-max="12" aria-live="polite">${s.cardSize}</output>
          <button type="button" data-act="step" data-t="s-n" data-d="-1" aria-label="טיפול אחד פחות">−</button>
        </div>
        <div id="s-preview">${nailRow(s.cardSize, s.cardSize, 'mid')}</div>
        <p class="help" id="s-n-help">${cardHelp(s.cardSize)}</p>
        <p class="help">ללקוחות חודשיות מומלץ 5 או 6. השינוי חל על כל הכרטיסיות.</p>
      </div>
      <div class="field">
        <label for="s-owner">הוואטסאפ שלך</label>
        <input class="input ltr" id="s-owner" type="tel" inputmode="tel" autocomplete="off" dir="ltr" maxlength="20" placeholder="050-000-0000" value="${esc(s.ownerPhone)}">
        <p class="help">לכאן נשלח סיכום הכרטיסיות.</p>
      </div>
      <div class="field">
        <label for="s-site">כתובת האתר</label>
        <input class="input ltr" id="s-site" type="url" inputmode="url" autocomplete="off" dir="ltr" maxlength="200" placeholder="https://sapinails.co.il" value="${esc(s.siteUrl)}">
        <p class="help">כשיש כתובת, כל הודעה ללקוחה כוללת לינק לכרטיסייה שלה, ובוואטסאפ הלינק מופיע כתמונה של הכרטיסייה.</p>
      </div>
      <button type="submit" class="btn primary big" id="s-save">שמירת הגדרות</button>
    </form>
    <div class="divider"></div>
    <div class="field">
      <span class="legend">סיכום ומעקב</span>
      <p class="help">כל הלקוחות, מי זכאית למתנה ומי לא הגיעה מזמן, בהודעת וואטסאפ אחת. טוב גם כגיבוי.</p>
      <button type="button" class="btn wa" data-act="summary">${IC.chat}<span>סיכום לוואטסאפ</span></button>
    </div>
  </div>`;
}

function waText(spec) {
  if (spec.custom != null) return spec.custom;
  if (!spec.id) return buildSummary();
  const c = S.clients.get(spec.id);
  return c ? buildMessage(spec.tpl, c) : '';
}
function waPhone(spec) {
  if (!spec.id) return S.settings.ownerPhone;
  const c = S.clients.get(spec.id);
  return c ? c.phone : '';
}
function waSheetHTML(spec) {
  const c = spec.id ? S.clients.get(spec.id) : null;
  if (spec.id && !c) return sheetHead(spec, 'הלקוחה לא נמצאה') + '<div class="sheet-body"><p class="help">ייתכן שהיא נמחקה ממכשיר אחר.</p></div>';
  const text = waText(spec), phone = waPhone(spec), href = waHref(phone, text);
  const chips = c ? `<div class="chips wrap" role="radiogroup" aria-label="סוג ההודעה">${TPLS.filter(t => t.k !== 'redeem' || c.rewards > 0).map(t => `<button type="button" class="chip" role="radio" aria-checked="${t.k === spec.tpl}" data-act="tpl" data-k="${t.k}">${t.label}</button>`).join('')}</div>` : '';
  const bubble = spec.editing
    ? `<label class="sr" for="wa-text">נוסח ההודעה</label><textarea class="bubble bubble-edit" id="wa-text" rows="10">${esc(text)}</textarea>`
    : `<div class="bubble" id="wa-preview">${fmtWa(text)}</div>`;
  const to = waNumber(phone)
    ? `נשלח אל <span class="phone" dir="ltr">${esc(fmtPhone(phone))}</span>`
    : c ? 'אין מספר שמור, וואטסאפ יבקש לבחור איש קשר.' : 'לא הוגדר מספר, וואטסאפ יבקש לבחור צ׳אט.';
  const title = c ? `הודעה ל${esc(firstName(c.name))}` : 'סיכום לוואטסאפ';
  return sheetHead(spec, title) + `<div class="sheet-body wa-body">
    ${chips}
    <div class="bubble-wrap">${bubble}</div>
    <div class="wa-meta"><span>${to}</span><button type="button" class="text-btn" data-act="wa-edit">${spec.editing ? 'חזרה לנוסח המוכן' : 'עריכת הנוסח'}</button></div>
    <div class="actions-row">
      <a class="btn wa" id="wa-link" href="${esc(href)}" target="_blank" rel="noopener noreferrer">${IC.chat}<span>פתיחה בוואטסאפ</span></a>
      <button type="button" class="btn ghost" data-act="wa-copy">${IC.copy}<span>העתקה</span></button>
    </div>
    <p class="fine">ההודעה נשלחת רק מתוך וואטסאפ, אחרי לחיצה על שליחה.${/\/k\/\d{1,2}\/\d{1,2}\//.test(text) ? ' כדאי לחכות שנייה עד שתמונת הכרטיסייה מופיעה מעל ההודעה, ורק אז לשלוח.' : ''}</p>
    ${href.length > 7000 ? '<p class="fine warn-txt">ההודעה ארוכה. אם וואטסאפ לא מציג את כל הטקסט, עדיף להעתיק ולהדביק.</p>' : ''}
  </div>`;
}
function updateWaLink(spec) {
  const a = $('#wa-link', spec.inner);
  if (a) a.href = waHref(waPhone(spec), waText(spec));
}

/* ---------- toasts & copy ---------- */
function toast(msg, actions = []) {
  const box = $('#toasts');
  while (box.children.length >= 2) box.firstChild.remove();
  const el = document.createElement('div');
  el.className = 'toast';
  const span = document.createElement('span');
  span.className = 't-msg';
  span.textContent = msg;
  el.appendChild(span);
  actions.forEach(a => {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = a.label;
    b.addEventListener('click', () => { el.remove(); a.fn(); });
    el.appendChild(b);
  });
  box.appendChild(el);
  setTimeout(() => el.remove(), actions.length ? 7000 : 4000);
}
function copyText(text, fallbackEl) {
  const fallback = () => {
    if (!fallbackEl) return toast('ההעתקה לא הצליחה');
    if (fallbackEl.select) { fallbackEl.focus(); fallbackEl.select(); }
    else { const r = document.createRange(); r.selectNodeContents(fallbackEl); const sel = getSelection(); sel.removeAllRanges(); sel.addRange(r); }
    toast('הטקסט מסומן, אפשר להעתיק ידנית');
  };
  try {
    navigator.clipboard.writeText(text).then(() => toast('הועתק'), fallback);
  } catch (_) { fallback(); }
}

/* ---------- data writes ---------- */
const queues = new Map();
function writeDoc(path, body) {
  const run = async () => {
    const ref = S.db.doc(path);
    try { await ref.set(body); }
    catch (e) {
      if (e && e.code === 'unavailable') { await sleep(300 + Math.random() * 500); await ref.set(body); }
      else throw e;
    }
  };
  const p = (queues.get(path) || Promise.resolve()).catch(() => {}).then(run);
  queues.set(path, p);
  return p;
}
function handleWriteError(e) {
  const code = e && e.code;
  if (code === 'invalid_argument' || code === 'not_granted' || code === 'revoked' || code === 'capability_disabled' || code === 'capability_removed') {
    S.canWrite = false; render();
    toast('השינוי לא נשמר: אין הרשאת עריכה בדף הזה.');
  } else if (code === 'quota_exceeded') {
    toast('נגמר המקום לרשומות חדשות. מחיקת לקוחות ישנות תפנה מקום.');
  } else {
    toast('השינוי לא נשמר. בדיקת החיבור לאינטרנט ואז ניסיון נוסף.');
  }
}
function commit(prevC, nextC) {
  S.clients.set(nextC.id, nextC);
  render();
  return writeDoc('clients/' + nextC.id, toDoc(nextC)).catch(err => {
    if (prevC) S.clients.set(prevC.id, prevC); else S.clients.delete(nextC.id);
    render();
    handleWriteError(err);
    throw err;
  });
}
function guardWrite() {
  if (!S.db || S.status !== 'ready') { toast('אין חיבור לאחסון הנתונים כרגע.'); return false; }
  if (!S.canWrite) { toast('אין הרשאת עריכה בדף הזה.'); return false; }
  return true;
}
const prevOf = c => ({ p: c.punches, r: c.rewards, v: c.visits, lv: c.lastVisit });

function punch(id, fromList) {
  if (!guardWrite()) return;
  const c = S.clients.get(id);
  if (!c) return;
  const N = S.settings.cardSize, now = Date.now();
  if (c.punches >= N) { openSheet({ type: 'client', id }); return; }
  if (S.lastPunch && S.lastPunch.id === id && now - S.lastPunch.t < 700) return;
  S.lastPunch = { id, t: now };
  const np = c.punches + 1;
  const next = { ...c, punches: np, visits: c.visits + 1, lastVisit: now, updatedAt: now,
    log: [...c.log, { t: now, a: 'punch', p: np, prev: prevOf(c) }].slice(-LOG_MAX) };
  S.justPainted = { id, idx: c.punches, at: now };
  setTimeout(() => { if (S.justPainted && S.justPainted.at === now) S.justPainted = null; }, 1200);
  commit(c, next).catch(() => {});
  if (fromList) {
    if (np >= N) toast(`הכרטיסייה של ${firstName(c.name)} התמלאה. הטיפול הבא מתנה`, [{ label: 'וואטסאפ', fn: () => openWa(id, 'visit') }]);
    else toast(`ניקוב ל${firstName(c.name)} · ${np}/${N}`, [{ label: 'וואטסאפ', fn: () => openWa(id, 'visit') }, { label: 'ביטול', fn: () => undo(id, now) }]);
  }
}
function redeem(id) {
  if (!guardWrite()) return;
  const c = S.clients.get(id);
  const N = S.settings.cardSize;
  if (!c || c.punches < N) return;
  const now = Date.now(), np = Math.max(0, c.punches - N);
  const next = { ...c, punches: np, rewards: c.rewards + 1, visits: c.visits + 1, lastVisit: now, updatedAt: now,
    log: [...c.log, { t: now, a: 'redeem', p: np, prev: prevOf(c) }].slice(-LOG_MAX) };
  commit(c, next).catch(() => {});
  toast(`טיפול המתנה מומש ונפתחה כרטיסייה חדשה ל${firstName(c.name)}`, [{ label: 'וואטסאפ', fn: () => openWa(id, 'redeem') }]);
}
function undo(id, expectT) {
  if (!guardWrite()) return;
  const c = S.clients.get(id);
  if (!c) return;
  const e = c.log[c.log.length - 1];
  if (!e || !e.prev || !UNDO_LABEL[e.a]) return;
  if (expectT && e.t !== expectT) { toast('בינתיים היה שינוי נוסף. אפשר לבטל מתוך הכרטיסייה.'); return; }
  const next = { ...c,
    punches: num(e.prev.p, c.punches), rewards: num(e.prev.r, c.rewards), visits: num(e.prev.v, c.visits),
    lastVisit: Number.isFinite(e.prev.lv) ? e.prev.lv : null, updatedAt: Date.now(), log: c.log.slice(0, -1) };
  commit(c, next).catch(() => {});
  toast(e.a === 'punch' ? 'הניקוב בוטל' : e.a === 'redeem' ? 'מימוש המתנה בוטל' : 'העדכון בוטל');
}
async function deleteClient(id) {
  if (!guardWrite()) return;
  const c = S.clients.get(id);
  try {
    await S.db.doc('clients/' + id).delete();
    S.clients.delete(id);
    closeAll();
    toast(`${c ? c.name : 'הלקוחה'} ${gw(c, 'נמחקה', 'נמחק')} מהכרטיסייה`);
  } catch (e) { handleWriteError(e); }
}
function openWa(id, tpl) {
  const c = S.clients.get(id);
  if (!c) return;
  openSheet({ type: 'wa', id, tpl: tpl || defaultTpl(c), custom: null, editing: false });
}

async function submitClient(spec) {
  if (!guardWrite()) return;
  const r = spec.inner;
  const name = $('#f-name', r).value.trim().replace(/\s+/g, ' ');
  const phone = $('#f-phone', r).value.trim();
  const g = $('#f-g-m', r).checked ? 'm' : 'f';
  const notes = $('#f-notes', r).value.trim();
  const punches = clamp(parseInt($('#f-p', r).textContent, 10) || 0, 0, S.settings.cardSize);
  const nameErr = $('#f-name-err', r), phoneErr = $('#f-phone-err', r);
  nameErr.hidden = !!name;
  if (!name) { $('#f-name', r).focus(); return; }
  if (phone && phone.replace(/\D/g, '').length < 9) {
    phoneErr.textContent = 'מספר הטלפון קצר מדי. צריך מספר מלא, למשל 050-123-4567.';
    phoneErr.hidden = false; return;
  }
  const wn = waNumber(phone);
  const dup = wn ? [...S.clients.values()].find(x => x.id !== spec.id && waNumber(x.phone) === wn) : null;
  if (dup && spec.dupAck !== wn) {
    phoneErr.textContent = `המספר כבר שמור אצל ${dup.name}. לחיצה נוספת על השמירה תשמור בכל זאת.`;
    phoneErr.hidden = false; spec.dupAck = wn; return;
  }
  phoneErr.hidden = true;
  const btn = $('#f-save', r);
  btn.disabled = true;
  const now = Date.now();
  try {
    if (spec.id) {
      const c = S.clients.get(spec.id);
      if (!c) { closeTop(); return; }
      const next = { ...c, name, phone, g, notes, updatedAt: now };
      if (punches !== Math.min(c.punches, S.settings.cardSize)) {
        next.punches = punches;
        next.log = [...c.log, { t: now, a: 'adjust', p: punches, prev: prevOf(c) }].slice(-LOG_MAX);
      }
      await commit(c, next);
      closeTop();
      toast('הפרטים נשמרו');
    } else {
      const ref = S.db.collection('clients').doc();
      const c = { id: ref.id, name, phone, g, notes, punches, rewards: 0, visits: punches, createdAt: now, lastVisit: null, updatedAt: now, log: [{ t: now, a: 'join', p: punches }] };
      await commit(null, c);
      openSheet({ type: 'client', id: c.id });
      toast(`${firstName(name)} ${g === 'm' ? 'נוסף' : 'נוספה'} לכרטיסייה`, [{ label: 'הודעת הצטרפות', fn: () => openWa(c.id, 'welcome') }]);
    }
  } catch (_) {
    if (document.contains(btn)) btn.disabled = false;
  }
}
async function submitSettings(spec) {
  if (!guardWrite()) return;
  const r = spec.inner;
  const next = {
    studioName: $('#s-name', r).value.trim().slice(0, 40),
    cardSize: clamp(parseInt($('#s-n', r).textContent, 10) || DEFAULTS.cardSize, 3, 12),
    ownerPhone: $('#s-owner', r).value.trim().slice(0, 20),
    siteUrl: $('#s-site', r).value.trim().slice(0, 200),
    updatedAt: Date.now(),
  };
  const prev = S.settings;
  S.settings = normSettings(next);
  $('#s-save', r).disabled = true;
  render();
  try {
    await writeDoc('meta/settings', next);
    closeTop();
    toast('ההגדרות נשמרו');
  } catch (e) {
    S.settings = prev; render(); handleWriteError(e);
    const b = $('#s-save', r); if (b) b.disabled = false;
  }
}

/* ---------- events ---------- */
document.addEventListener('click', e => {
  const el = e.target.closest('[data-act]');
  if (!el || el.disabled) return;
  const act = el.dataset.act, id = el.dataset.id, spec = topSheet();
  switch (act) {
    case 'add': if (guardWrite()) openSheet({ type: 'edit', id: null }); break;
    case 'open': openSheet({ type: 'client', id }); break;
    case 'qpunch': punch(id, true); break;
    case 'punch': punch(id, false); break;
    case 'redeem': redeem(id); break;
    case 'undo': undo(id); break;
    case 'wa': openWa(id); break;
    case 'edit': if (guardWrite()) openSheet({ type: 'edit', id }); break;
    case 'close': closeTop(); break;
    case 'settings': openSheet({ type: 'settings' }); break;
    case 'summary': openSheet({ type: 'wa', id: null, tpl: 'summary', custom: null, editing: false }); break;
    case 'filter': S.filter = el.dataset.f; render(); break;
    case 'tpl':
      if (spec && spec.type === 'wa') { spec.tpl = el.dataset.k; spec.custom = null; spec.editing = false; fillSheet(spec, true); }
      break;
    case 'wa-edit':
      if (spec && spec.type === 'wa') {
        if (spec.editing) { spec.editing = false; spec.custom = null; }
        else { spec.custom = waText(spec); spec.editing = true; }
        fillSheet(spec, true);
        const ta = $('#wa-text', spec.inner);
        if (ta) ta.focus({ preventScroll: true });
      }
      break;
    case 'wa-copy':
      if (spec && spec.type === 'wa') {
        const ta = $('#wa-text', spec.inner);
        copyText(ta ? ta.value : waText(spec), ta || $('#wa-preview', spec.inner));
      }
      break;
    case 'copy-phone': {
      const c = S.clients.get(id);
      if (c) copyText(fmtPhone(c.phone), el.parentElement.querySelector('.phone'));
      break;
    }
    case 'delete-ask': if (spec) { spec.confirmDelete = true; fillSheet(spec, false); } break;
    case 'delete-no': if (spec) { spec.confirmDelete = false; fillSheet(spec, false); } break;
    case 'delete-yes': deleteClient(id); break;
    case 'step': {
      const out = document.getElementById(el.dataset.t);
      if (!out) break;
      const v = clamp((parseInt(out.textContent, 10) || 0) + Number(el.dataset.d), Number(out.dataset.min), Number(out.dataset.max));
      out.textContent = v;
      if (el.dataset.t === 's-n') {
        $('#s-preview').innerHTML = nailRow(v, v, 'mid');
        $('#s-n-help').textContent = cardHelp(v);
      }
      break;
    }
  }
});
document.addEventListener('submit', e => {
  e.preventDefault();
  const spec = topSheet();
  if (!spec) return;
  if (e.target.id === 'clientForm') submitClient(spec);
  else if (e.target.id === 'settingsForm') submitSettings(spec);
});
document.addEventListener('input', e => {
  if (e.target.id === 'q') { S.q = e.target.value; renderMain(); }
  else if (e.target.id === 'wa-text') { const spec = topSheet(); if (spec) { spec.custom = e.target.value; updateWaLink(spec); } }
  else if (e.target.id === 'f-phone') { const spec = topSheet(); if (spec) spec.dupAck = null; }
});
document.addEventListener('keydown', e => { if (e.key === 'Escape' && S.stack.length) closeTop(); });

/* ---------- data subscription ---------- */
let subTries = 0;
function subscribe() {
  if (S.unsubC) S.unsubC();
  if (S.unsubS) S.unsubS();
  S.unsubC = S.db.collection('clients').onSnapshot(snap => {
    const m = new Map();
    snap.docs.forEach(d => { if (d.exists) { const data = d.data(); if (data) m.set(d.id, normClient(d.id, data)); } });
    S.clients = m;
    S.status = 'ready';
    S.slow = false;
    render();
  }, onSubError);
  S.unsubS = S.db.doc('meta/settings').onSnapshot(snap => {
    S.settings = normSettings(snap.exists ? snap.data() : null);
    render();
  }, onSubError);
}
function onSubError(err) {
  const code = err && err.code;
  if (['revoked', 'not_granted', 'capability_disabled', 'capability_removed'].includes(code)) {
    S.canWrite = false;
    if (S.status === 'loading') S.status = 'nodb';
    render();
    return;
  }
  if (subTries < 3) { subTries++; setTimeout(subscribe, 1500 * subTries); }
}

async function init() {
  render();
  setTimeout(() => { if (S.status === 'loading') { S.slow = true; render(); } }, 12000);
  const cl = window.claude;
  if (!cl || typeof cl.use !== 'function') { S.status = 'nodb'; render(); return; }
  let db = null;
  try { db = await cl.use('db'); } catch (_) { db = null; }
  if (!db) { S.status = 'nodb'; render(); return; }
  S.db = db;
  subscribe();
  try {
    const u = await cl.use('user');
    if (u && typeof u.can === 'function') {
      const w = await u.can('data.write');
      if (w === false) { S.canWrite = false; render(); }
    }
  } catch (_) {}
}
init();
})();
