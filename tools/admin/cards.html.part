
<div class="app" dir="rtl" lang="he">
  <header class="top">
    <div class="brand">
      <div class="eyebrow" id="eyebrow">כרטיסיית מועדון</div>
      <h1 class="studio" id="studio">הסטודיו של ספיר</h1>
      <div class="sub" id="sub"></div>
    </div>
    <button type="button" class="icon-btn" data-act="settings" aria-label="הגדרות הכרטיסייה"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg></button>
  </header>

  <div class="banner" id="banner" role="status" hidden></div>

  <div class="toolbar" id="toolbar" hidden>
    <label class="search" for="q">
      <span class="sr">חיפוש לקוחה</span>
      <svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
      <input id="q" type="search" placeholder="חיפוש לפי שם או טלפון" autocomplete="off" enterkeyhint="search">
    </label>
    <div class="chips" role="group" aria-label="סינון לקוחות">
      <button type="button" class="chip" data-act="filter" data-f="all" aria-pressed="true">הכל <span class="n" id="n-all">0</span></button>
      <button type="button" class="chip" data-act="filter" data-f="gift" aria-pressed="false">מתנה מוכנה <span class="n" id="n-gift">0</span></button>
      <button type="button" class="chip" data-act="filter" data-f="away" aria-pressed="false">מזמן לא הגיעו <span class="n" id="n-away">0</span></button>
    </div>
  </div>

  <main id="main"></main>
</div>

<button type="button" class="btn primary fab" id="addBtn" data-act="add" dir="rtl" hidden><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span>לקוחה חדשה</span></button>
<div id="sheets" dir="rtl" lang="he"></div>
<div class="toasts" id="toasts" dir="rtl" lang="he" aria-live="polite"></div>
